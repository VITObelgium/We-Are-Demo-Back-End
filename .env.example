HOST=localhost
PORT=3099
PROTOCOL=http

# URL at which this We Are Demo Back-End instance is publicly reachable.
# Required for building absolute redirect URLs (e.g. the OIDC/HTI callback endpoints, see
# `globalThis.backendUrl`).
BACKEND_URL=http://localhost:3099

# The URL of your We Are Demo Front-End instance.
# Required for redirecting and CORS whitelist.
FRONTEND_URL=http://localhost:4299
FRONTEND_LOGIN_PATH=/login

# The We Are platform environment that is active by default when the back-end starts.
# One of: DEV, TST, ACC, PRD. Can be switched at runtime per session from the front-end
# (see the /client-credentials endpoint), this only controls the initial/default value.
WEARE_ENVIRONMENT=ACC

# The OpenID provider used for authenticating user agents and citizens, per We Are environment.
# The endpoints are resolved from the provider its .well-known/openid-configuration document.
# You can use the ACC default value below to operate on the We Are acceptance environment.
WEARE_OIDC_URL_ACC=https://openid.we-are-acc.vito.be
# WEARE_OIDC_URL_DEV=https://utils.we-are-tst.vito.be/dev/weare-idp
# WEARE_OIDC_URL_TST=https://openid.we-are-tst.vito.be
# WEARE_OIDC_URL_PRD=https://openid.we-are-health.be

# Client credentials used for authenticating your user agent, per We Are environment.
# Please ask your We Are contact for this information.
# You can configure multiple client id/secret pairs per environment by incrementing the
# enumeration index (_1_, _2_, ...) and switch between them from the front-end. The display
# name (optional, defaults to "Client <index>") is shown in the front-end's switcher.
WEARE_OIDC_CLIENT_ID_1_ACC=
WEARE_OIDC_CLIENT_SECRET_1_ACC=
# WEARE_OIDC_CLIENT_DISPLAY_NAME_1_ACC=
# WEARE_OIDC_CLIENT_ID_2_ACC=
# WEARE_OIDC_CLIENT_SECRET_2_ACC=
# WEARE_OIDC_CLIENT_DISPLAY_NAME_2_ACC=

# WEARE_OIDC_CLIENT_ID_1_DEV=
# WEARE_OIDC_CLIENT_SECRET_1_DEV=
# WEARE_OIDC_CLIENT_DISPLAY_NAME_1_DEV=

# WEARE_OIDC_CLIENT_ID_1_TST=
# WEARE_OIDC_CLIENT_SECRET_1_TST=
# WEARE_OIDC_CLIENT_DISPLAY_NAME_1_TST=

# WEARE_OIDC_CLIENT_ID_1_PRD=
# WEARE_OIDC_CLIENT_SECRET_1_PRD=
# WEARE_OIDC_CLIENT_DISPLAY_NAME_1_PRD=

# The name of your application
# Can be shown when logging into the OIDC provider.
WEARE_OIDC_CLIENT_NAME=We Are Demo Back-End

# The URL of the We Are PIMS instance used for the HTI (Health Tools Interoperability) flow, per We Are environment.
WEARE_PIMS_URL_ACC=https://we-are-acc.vito.be
# WEARE_PIMS_URL_DEV=http://localhost:4201
# WEARE_PIMS_URL_TST=https://we-are-tst.vito.be
# WEARE_PIMS_URL_PRD=https://we-are-health.be

# The URL of the ESS instance used for issuing and deriving verifiable credentials, per We Are environment.
# You can use the ACC default value below to operate on the We Are acceptance environment.
WEARE_VC_SERVICE_ACC=https://credential.we-are-services-acc.vito.be
# WEARE_VC_SERVICE_DEV=http://localhost:3015
# WEARE_VC_SERVICE_TST=https://credential.we-are-services-tst.vito.be
# WEARE_VC_SERVICE_PRD=https://credential.we-are-services.vito.be

# The URL of the Athumi Pod Platform instance used for provisioning WebIDs, per We Are environment.
WEARE_WEB_ID_PROVISION_SERVICE_ACC=https://pod-platform.api.tni-athumi.eu
# WEARE_WEB_ID_PROVISION_SERVICE_DEV=
# WEARE_WEB_ID_PROVISION_SERVICE_TST=
# WEARE_WEB_ID_PROVISION_SERVICE_PRD=

# Path on the pod platform used for creating / deleting Web ID's.
WEARE_WEB_ID_PROVISION_SERVICE_PATH=/v1/webids

# The URL of the We Are Access Management Application (AMA), used for acquiring user consent
# (access grants), per We Are environment. Used by the `/access-request/consent` endpoint to
# redirect the citizen to the AMA.
AMA_URL_ACC=https://we-are-acc.vito.be
# AMA_URL_DEV=http://localhost:4201
# AMA_URL_TST=https://we-are-tst.vito.be
# AMA_URL_PRD=https://we-are-health.be

# The path used for acquiring user consent (access grants), per We Are environment.
AMA_CONSENT_PATH_ACC=/en/access-request
# AMA_CONSENT_PATH_DEV=/en/access-request
# AMA_CONSENT_PATH_TST=/en/access-request
# AMA_CONSENT_PATH_PRD=/en/access-request